<Project>
  <ItemGroup>
    <!-- Core / System -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
    <!-- Pruebas -->
